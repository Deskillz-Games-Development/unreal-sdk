void UDeskillzHostRoomSwitcherWidget::SetRoomPaused(const FString& RoomId, bool bPaused)
{
    int32 Index = FindRoomIndex(RoomId);
    if (Index == INDEX_NONE)
    {
        return;
    }

    // Update stored data
    WatchedRooms[Index].bIsActive = !bPaused;

    // Update tab widget
    if (UUserWidget** TabWidgetPtr = TabWidgets.Find(RoomId))
    {
        UpdateRoomTab(*TabWidgetPtr, WatchedRooms[Index]);
    }
}

void UDeskillzHostRoomSwitcherWidget::UpdatePlayerCount(const FString& RoomId, int32 Count)
{
    int32 Index = FindRoomIndex(RoomId);
    if (Index == INDEX_NONE)
