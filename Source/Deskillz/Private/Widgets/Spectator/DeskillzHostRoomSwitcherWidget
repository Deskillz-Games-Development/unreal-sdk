    : Super(ObjectInitializer)
{
}

void UDeskillzHostRoomSwitcherWidget::NativeConstruct()
{
    Super::NativeConstruct();

    // Set host label
    if (HostLabelText)
    {
        HostLabelText->SetText(FText::FromString(TEXT("YOUR ROOMS:")));
    }

    // Bind add button
    if (AddRoomButton)
    {
        AddRoomButton->OnClicked.AddDynamic(this, &UDeskillzHostRoomSwitcherWidget::OnAddButtonClicked);
    }

    // Initialize displays
    UpdateRoomCountDisplay();
    UpdateAddButtonState();
}

// ============================================================================
// Room Management
// ============================================================================

void UDeskillzHostRoomSwitcherWidget::AddRoom(const FDeskillzHostRoom& Room)
{
    // Check if at max
    if (WatchedRooms.Num() >= MaxRooms)
    {
        UE_LOG(LogTemp, Warning, TEXT("[HostRoomSwitcher] Cannot add room - at maximum (%d)"), MaxRooms);
        return;
    }

    // Check if already exists
    for (const FDeskillzHostRoom& Existing : WatchedRooms)
    {
        if (Existing.Id == Room.Id)
        {
            UE_LOG(LogTemp, Warning, TEXT("[HostRoomSwitcher] Room already in list: %s"), *Room.Id);
            return;
        }
    }

    // Add room
    WatchedRooms.Add(Room);

    // Create tab widget
    UUserWidget* TabWidget = CreateRoomTab(Room);
    if (TabWidget && TabsContainer)
    {
        TabsContainer->AddChild(TabWidget);
        TabWidgets.Add(Room.Id, TabWidget);
    }

    // Set as active if first room
    if (WatchedRooms.Num() == 1)
    {
        SetActiveRoom(Room.Id);
    }

    UpdateRoomCountDisplay();
    UpdateAddButtonState();

    UE_LOG(LogTemp, Log, TEXT("[HostRoomSwitcher] Added room: %s (%s)"), *Room.Name, *Room.RoomCode);
}

void UDeskillzHostRoomSwitcherWidget::RemoveRoom(const FString& RoomId)
{
    int32 Index = FindRoomIndex(RoomId);
    if (Index == INDEX_NONE)
    {
        return;
    }

    // Remove from array
    WatchedRooms.RemoveAt(Index);

    // Remove widget
    if (UUserWidget** TabWidgetPtr = TabWidgets.Find(RoomId))
    {
        if (*TabWidgetPtr)
        {
            (*TabWidgetPtr)->RemoveFromParent();
        }
        TabWidgets.Remove(RoomId);
    }

    // Update active room if needed
    if (ActiveRoomId == RoomId)
    {
        if (WatchedRooms.Num() > 0)
        {
            SetActiveRoom(WatchedRooms[0].Id);
        }
        else
        {
            ActiveRoomId.Empty();
        }
    }

    UpdateRoomCountDisplay();
    UpdateAddButtonState();

    UE_LOG(LogTemp, Log, TEXT("[HostRoomSwitcher] Removed room: %s"), *RoomId);
}

void UDeskillzHostRoomSwitcherWidget::UpdateRoom(const FDeskillzHostRoom& Room)
{
    int32 Index = FindRoomIndex(Room.Id);
    if (Index == INDEX_NONE)
    {
        return;
    }

    // Update stored data
    WatchedRooms[Index] = Room;

    // Update tab widget
    if (UUserWidget** TabWidgetPtr = TabWidgets.Find(Room.Id))
    {
        UpdateRoomTab(*TabWidgetPtr, Room);
    }
}

void UDeskillzHostRoomSwitcherWidget::SetActiveRoom(const FString& RoomId)
{
    if (ActiveRoomId == RoomId)
    {
        return;
    }

    // Verify room exists
    int32 Index = FindRoomIndex(RoomId);
    if (Index == INDEX_NONE)
    {
        UE_LOG(LogTemp, Warning, TEXT("[HostRoomSwitcher] Cannot set active - room not found: %s"), *RoomId);
        return;
    }

    ActiveRoomId = RoomId;
    UpdateTabActiveStates();
    ScrollToActiveTab();

    UE_LOG(LogTemp, Log, TEXT("[HostRoomSwitcher] Active room: %s"), *RoomId);
}

void UDeskillzHostRoomSwitcherWidget::ClearRooms()
{
    // Remove all tab widgets
    for (auto& Pair : TabWidgets)
    {
        if (Pair.Value)
        {
            Pair.Value->RemoveFromParent();
        }
    }
    TabWidgets.Empty();

    // Clear data
    WatchedRooms.Empty();
    ActiveRoomId.Empty();

    UpdateRoomCountDisplay();
    UpdateAddButtonState();

    UE_LOG(LogTemp, Log, TEXT("[HostRoomSwitcher] Cleared all rooms"));
}

