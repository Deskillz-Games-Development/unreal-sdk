int32 UDeskillzHostRoomSwitcherWidget::FindRoomIndex(const FString& RoomId) const
{
    for (int32 i = 0; i < WatchedRooms.Num(); ++i)
    {
        if (WatchedRooms[i].Id == RoomId)
        {
            return i;
        }
    }
    return INDEX_NONE;
}

