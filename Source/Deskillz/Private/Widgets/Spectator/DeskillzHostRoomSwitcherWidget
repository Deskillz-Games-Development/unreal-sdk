    if (UUserWidget** TabWidgetPtr = TabWidgets.Find(RoomId))
    {
        UpdateRoomTab(*TabWidgetPtr, WatchedRooms[Index]);
    }
}

void UDeskillzHostRoomSwitcherWidget::UpdateRoomRound(const FString& RoomId, int32 RoundNumber)
{
    int32 Index = FindRoomIndex(RoomId);
    if (Index == INDEX_NONE)
    {
        return;
